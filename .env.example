# ---------------------------------------------------------------------
# K-Space V2 — variabel lingkungan
#
# Salin berkas ini menjadi .env.local lalu isi dari dasbor Supabase
# (Project Settings → API). Tanpa ini aplikasi berjalan dalam MODE DEMO:
# data contoh, tidak tersimpan ke mana pun.
# ---------------------------------------------------------------------

# Wajib — dipakai browser & server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional — hanya untuk skrip administratif (migrasi data lama, seed).
# JANGAN pernah diawali NEXT_PUBLIC_ dan jangan di-commit.
SUPABASE_SERVICE_ROLE_KEY=

# Radius validasi lokasi absensi (meter) dan titik kantor.
NEXT_PUBLIC_KANTOR_LAT=-6.2607
NEXT_PUBLIC_KANTOR_LNG=106.8106
NEXT_PUBLIC_KANTOR_RADIUS_M=150

# ---------------------------------------------------------------------
# Gateway WhatsApp (PRD Fase 4) — opsional
#
# Kosong berarti kanal WhatsApp mati: notifikasi tetap terbit di dalam
# aplikasi, antreannya tetap terisi, dan pengirimannya menunggu sampai
# kredensial ini ada. Tidak ada yang hilang selama itu.
#
# TIDAK memakai awalan NEXT_PUBLIC_ dengan sengaja: token yang ikut ke
# bundel browser berarti siapa pun bisa mengirim pesan atas nama
# perusahaan.
# ---------------------------------------------------------------------
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
# Nomor pengirim yang terdaftar di gateway, bentuk baku +62…
WA_GATEWAY_NOMOR=

# Rahasia bersama untuk pekerjaan terjadwal (pemroses antrean WhatsApp).
# Kosong berarti endpoint pemrosesnya MATI — bukan terbuka.
CRON_SECRET=
