{
  "name": "kspace-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:cek": "node scripts/cek-migrasi.mjs",
    "db:test": "node scripts/jalankan-tes-db.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"supabase/**/*.mjs\" \"scripts/*.mjs\"",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run db:test && npm run build",
    "db:seed:sql": "node scripts/buat-seed-sql.mjs",
    "test:unit": "node --import ./scripts/alias-ts.mjs --test \"src/lib/__tes__/*.test.ts\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "cn": "^0.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
