{
  "name": "kspace-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:cek": "node scripts/cek-migrasi.mjs",
    "db:test": "node scripts/jalankan-tes-db.mjs",
    "migrasi:v1": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/jalankan-migrasi-v1.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"supabase/**/*.mjs\" \"scripts/*.mjs\"",
    "verify": "node scripts/verify.mjs",
    "db:seed:sql": "node scripts/buat-seed-sql.mjs",
    "ekspor:contoh": "node scripts/buat-ekspor-contoh.mjs",
    "ekspor:cek": "node scripts/buat-ekspor-contoh.mjs --cek",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-ts.mjs --test \"src/lib/__tes__/*.test.ts\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "cn": "^0.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
